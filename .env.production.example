# 本番用の環境変数の一覧(値はホスティング側の管理画面で設定する。このファイルに本物の値を書かない)

APP_NAME=どこでも大喜利
APP_ENV=production        # local のままだと ?as= のなりすましが有効になる。必ず production
APP_DEBUG=false
APP_KEY=                  # php artisan key:generate --show で本番用を新しく作る
APP_URL=https://(公開URL)

LOG_LEVEL=warning

# DB / Redis: Laravel Cloud などは接続情報を自動で入れる。自前の場合のみ設定
DB_CONNECTION=pgsql
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database   # イベントは ShouldBroadcastNow なので、キューワーカーは不要

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=              # 本番用に新しく作る(ローカルの値を使い回さない)
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=(Reverb の公開ホスト名)
REVERB_PORT=443
REVERB_SCHEME=https
# ブラウザ用の値。ビルド時に埋め込まれるので、変更したら再ビルドが必要
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
